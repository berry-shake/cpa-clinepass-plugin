{
  "case": "quota_fetch_plan_usage",
  "description": "quota.fetch reads the usage limits and the plan: 5h / 7d / monthly bars and the plan name; repeats come from the cache",
  "setup": {
    "version": "9.9.9-snapshot",
    "config": {
      "base-url": "{{UPSTREAM}}",
      "data-dir": "{{DATA_DIR}}",
      "enabled": true,
      "priority": 0
    },
    "credentials": [
      {
        "name": "clinepass-k1.json",
        "fields": {
          "api_key": "cline_test_fake_key_0001",
          "type": "clinepass"
        }
      }
    ]
  },
  "upstream_script": [
    {
      "method": "GET",
      "path": "/api/v1/users/me/plan/usage-limits",
      "status": 200,
      "header": {
        "Content-Type": [
          "application/json"
        ]
      },
      "body": "{\"success\":true,\"data\":{\"limits\":[{\"type\":\"five_hour\",\"percentUsed\":12.5,\"resetsAt\":\"2026-01-02T07:00:00Z\"},{\"type\":\"weekly\",\"percentUsed\":40,\"resetsAt\":\"2026-01-05T00:00:00Z\"},{\"type\":\"monthly\",\"percentUsed\":75,\"resetsAt\":\"2026-01-20T09:30:00Z\"}]}}",
      "chunks": []
    },
    {
      "method": "GET",
      "path": "/api/v1/users/me/plan",
      "status": 200,
      "header": {
        "Content-Type": [
          "application/json"
        ]
      },
      "body": "{\"success\":true,\"data\":{\"userId\":\"user-fake-1\",\"subscriptionId\":\"sub-fake-1\",\"currentPeriodEnd\":\"2026-01-20T09:30:00Z\",\"plan\":{\"displayName\":\"Cline Pass (Monthly)\"}}}",
      "chunks": []
    }
  ],
